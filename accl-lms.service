[Unit]
Description=ACCL Learning Management System & Classroom Portal
After=network.target postgresql.service

[Service]
Type=simple
User=kishan
WorkingDirectory=/data/admin/ACCLLMS
Nice=10
Environment="PORT=8095"
Environment="HOST=0.0.0.0"
Environment="STORAGE_DIR=/data/admin/ACCLLMS/storage"
Environment="DATABASE_URL=postgresql://kishan_accl:HoodleLMS_Secure_2026@127.0.0.1:5432/accl_lms"
Environment="DATABASE_BACKEND=postgres"
Environment="CUDA_VISIBLE_DEVICES="
Environment="GMAIL_SMTP_USER=hoodle.lms@gmail.com"
Environment="GMAIL_FROM_NAME=Hoodle LMS"
ExecStart=/usr/bin/gunicorn --workers 2 --threads 4 --worker-class gthread --backlog 2048 --worker-tmp-dir /dev/shm --bind 0.0.0.0:8096 --timeout 120 --keep-alive 5 --max-requests 2000 --max-requests-jitter 200 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
